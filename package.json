{
  "name": "design-intake-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cycle7": "vitest run --config vitest.cycle7.config.ts",
    "test:ap5": "playwright test",
    "release:check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ios:add": "node node_modules/@capacitor/cli/bin/capacitor add ios",
    "ios:sync": "node node_modules/@capacitor/cli/bin/capacitor sync ios",
    "ios:open": "node node_modules/@capacitor/cli/bin/capacitor open ios",
    "android:debug": "cd android-twa && ./gradlew assembleDebug",
    "android:release:unsigned": "cd android-twa && ./gradlew assembleRelease bundleRelease",
    "android:verify": "cd android-twa && ./gradlew lintRelease",
    "deploy:prod": "vercel --prod",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "fetch:media": "node scripts/fetch-landing-media.mjs",
    "provision:ap1": "tsx scripts/provision-ap1-users.ts",
    "worker:release-artifacts": "tsx scripts/run-release-artifact-worker.ts",
    "bridge:telegram-notifications": "tsx scripts/run-telegram-notifications.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "ajv": "^8.17.1",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.185.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.185.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
