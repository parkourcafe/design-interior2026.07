# ── Supabase ─────────────────────────────────────────────
# Project URL and publishable key are public (used in the browser client).
# Legacy anon key remains a compatibility fallback through the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ProjectCEO invitation/guest opaque-token derivation — SERVER ONLY.
# Use at least 32 random bytes; rotating it invalidates unaccepted raw links.
PROJECTCEO_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# ── RemHaOS Integration Gateway flags ───────────────────
# Default-off. Enabling any provider in staging requires a separate OWNER GO.
REMHAOS_INTEGRATIONS_ENABLED=false
REMHAOS_PROJECT_LINKS_ENABLED=false
REMHAOS_FILE_INTAKE_ENABLED=false
REMHAOS_TELEGRAM_BRIDGE_ENABLED=false
REMHAOS_TELEGRAM_WORKER_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
REMHAOS_GOOGLE_DRIVE_ENABLED=false
# Google Drive staging OAuth credentials — SERVER ONLY; production remains off.
GOOGLE_DRIVE_CLIENT_ID=your-google-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-staging-host.example/api/integrations/google_drive/oauth/callback
# Explicit non-production adapters. Default values are fail-closed.
REMHAOS_SECRET_STORE_ADAPTER=fail_closed
REMHAOS_WORKER_TRANSPORT=disabled
REMHAOS_FILE_SCANNER_ADAPTER=fail_closed

# ── LLM provider (продукт) ───────────────────────────────
# yandex | gigachat | zai
# ВНИМАНИЕ: 'zai' (Zhipu GLM, китайский провайдер) — отступление от guardrail
# CLAUDE.md, включён по явному решению владельца. Прод по умолчанию — yandex.
LLM_PROVIDER=yandex
# YandexGPT: yandexgpt-lite | yandexgpt   (или полный gpt://<folder>/<model>/latest)
# GigaChat:  GigaChat | GigaChat-Pro
# z.ai:      glm-4.6 | glm-4.5-air | glm-4.7-flash
LLM_MODEL=yandexgpt-lite

# Yandex Cloud Foundation Models
YC_FOLDER_ID=your-folder-id
YC_API_KEY=your-yc-api-key

# GigaChat (запасной провайдер) — заполняется при переключении
GIGACHAT_AUTH_KEY=

# z.ai / Zhipu GLM (опциональный провайдер, LLM_PROVIDER=zai)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI GLM-OCR for plan/image/PDF text extraction.
ZAI_OCR_MODEL=glm-ocr

# ── App ──────────────────────────────────────────────────
# Канонический production URL для публичных ссылок. В локальном .env.local
# используйте http://localhost:3000. Без завершающего слеша.
NEXT_PUBLIC_APP_URL=https://www.remhaos.com

# Контакт поддержки: клиентский бриф (рядом с согласием на ПДн), футер
# лендинга и письма заявок на пилот. Убедитесь, что ящик реально принимает
# почту (иначе выставьте свой, например support@example.com).
NEXT_PUBLIC_SUPPORT_EMAIL=<support-email>

# Юридические реквизиты владельца/оператора ПДн. Обязательны перед App Store.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=<legal-operator-name>
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=<legal-operator-address>
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL=<legal-operator-email>
NEXT_PUBLIC_LEGAL_OPERATOR_PHONE=<legal-operator-phone>

# Apple Developer Team ID (10 символов). Используется AASA и signing.
APPLE_TEAM_ID=<apple-team-id>

# Медиа лендинга. Пусто = CDN Higgsfield (по умолчанию). Чтобы хостить у себя:
#   npm run fetch:media   (скачает файлы в public/landing)
#   NEXT_PUBLIC_MEDIA_BASE=/landing
NEXT_PUBLIC_MEDIA_BASE=

# ── TWA / магазины приложений (Google Play + RuStore) ────
# Digital Asset Links для /.well-known/assetlinks.json (скрывает адресную
# строку в приложении). Заполнить ПОСЛЕ сборки AAB и получения отпечатков.
# Package name приложения, напр. space.arhidom.twa
ANDROID_PACKAGE_NAME=
# Отпечаток(и) SHA-256, через запятую. Нужны ОБА сертификата:
#   1) Google Play App Signing (Play Console → App integrity)
#   2) подпись RuStore (ваш upload keystore)
# Пример: AB:CD:...:EF, 12:34:...:90
ANDROID_CERT_SHA256=

# ── AP1 authenticated pilot (disposable-окружение, НЕ прод) ──
# Используются только скриптом `npm run provision:ap1`, который создаёт пять
# ролевых пользователей (owner/designer/builder/client/guest).
# Домен для тестовых адресов вида owner@ap1.<домен>.
AP1_EMAIL_DOMAIN=remhaos.test
# Пароль для всех пяти тестовых пользователей, минимум 12 символов.
AP1_TEST_PASSWORD=
# Предохранитель: скрипт не запустится без явного AP1_CONFIRM_DISPOSABLE=yes.
# Ставить ТОЛЬКО когда NEXT_PUBLIC_SUPABASE_URL указывает на disposable-проект.
AP1_CONFIRM_DISPOSABLE=

# ── Модуль 2: редактор планировок ────────────────────────────
# Модуль выключен по умолчанию. При false страницы планировок в кабинете и
# /api/layout-studio отдают 404. Данные редактора живут на сервере
# (layout_documents / layout_checkpoints, RLS) — включать можно только после
# применения миграции 20260808050000.
ARCHIDOM_LAYOUT_STUDIO_ENABLED=false
# ── Модуль 3 «Документация» (Addendum A5, DEC-024) ──────────
# Выключен: при false поверхности и команды модуля недоступны.
REMHAOS_DOCUMENTATION_ENABLED=false
# ── Модуль 4 «Исполнение» (guardrail от 10.08.2026, A6/DEC-025) ──────────
# Выключен: при false команды модуля отказывают до сети, а его поверхности
# отдаются как module_disabled. Отсутствие переменной означает «закрыто».
# Вторая граница — в базе: миграция 20260810070000 отзывает execute у роли
# authenticated на командные RPC projectceo_m4_api, потому что схема отдана
# Data API и вызов мог идти мимо приложения. Включение — отдельное решение
# владельца и не раньше снятия PLATFORM_FOUNDATION = BLOCKED.
#
# Для вертикали V1 Impact решение принято (DEC-033), и вторая половина
# выключателя переехала из скрипта харнесса в постоянный механизм:
# projectceo_m4.open_v1_impact_production(actor, basis) — с обязательными
# подписью и основанием и записью в projectceo_m4.production_switch_log.
# Порядок включения и откат — M4_V1_PRODUCTION_RUNBOOK.md. Эта переменная
# по-прежнему обязательна: без неё команды модуля не доходят до базы.
REMHAOS_EXECUTION_ENABLED=false
# ── Telegram Chat Bridge (Addendum A7, DEC-031) ──────────
# Выключен: при false маршрут webhook отдаёт 404, отправитель уведомлений
# отказывается работать, экран подключения показывает «мост выключен».
# Отсутствие переменной означает «закрыто»; открывает только строка "true".
# Вторая граница — в базе: системные RPC схемы remhaos_channel_api выданы
# только service_role, и человеческая сессия до них не достаёт ни при каком
# значении этого флага. Production Telegram этим флагом НЕ разрешается —
# нужно отдельное решение владельца (A7 §1.11).
REMHAOS_TELEGRAM_BRIDGE_ENABLED=false
# Учётные данные тестового бота. В базу не попадают и в логи не пишутся.
# Имена содержат TEST_ намеренно: пока production не разрешён, продовых имён
# заводить не за чем. Порядок настройки — docs/canonical/remhaos-v1/
# REMHAOS_TELEGRAM_BRIDGE_RUNBOOK.md
TELEGRAM_TEST_BOT_TOKEN=
TELEGRAM_TEST_WEBHOOK_SECRET=
TELEGRAM_TEST_BOT_USERNAME=
# Тестовая группа. Нужна ТОЛЬКО внешнему гейту TG4; её отсутствие не мешает
# ни одному из гейтов TG0–TG3.
TELEGRAM_TEST_CHAT_ID=

# ── Disposable gates and bounded workers ─────────────────
# M4 V2/V3 разрешены только для local/disposable проверки; production закрыт.
REMHAOS_M4_V2_V3_ENABLED=false
# Удаление Google Drive-файлов выключено, пока владелец не откроет gate.
REMHAOS_GOOGLE_DRIVE_REVOKE_ENABLED=false
# Максимум строк за один проход воркера; значения совпадают с runtime defaults.
RELEASE_WORKER_MAX_ROWS=100
IMPACT_WORKER_MAX_ROWS=100
INGEST_WORKER_MAX_ROWS=100
TELEGRAM_PROJECTION_MAX_ROWS=50
TELEGRAM_NOTIFICATION_MAX_ROWS=20
TELEGRAM_EXTRACTION_MAX_ROWS=20
# Ротация пароля существующих AP1-пользователей требует явного yes.
AP1_ROTATE_EXISTING_PASSWORD=no
# Необязательный каталог сборки Next.js; production default — .next.
NEXT_DIST_DIR=.next

# Optional public registration details; verify against a current EGRIP extract.
# Leave unset until verified; these are public Config values, not secrets.
NEXT_PUBLIC_LEGAL_OPERATOR_INN=
NEXT_PUBLIC_LEGAL_OPERATOR_OGRNIP=
NEXT_PUBLIC_LEGAL_OPERATOR_REGISTRATION_AUTHORITY=
NEXT_PUBLIC_LEGAL_OPERATOR_REGISTRATION_DATE=

# Dormant consent enforcement. Enable only after approved immutable documents,
# explicit capability lifetime and data-plane/legal activation review.
# Does not disable direct database RPCs; active_requirements is the DB gate.
REMHAOS_CONSENT_ENABLED=false
