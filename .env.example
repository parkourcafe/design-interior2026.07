# ── Supabase ─────────────────────────────────────────────
# Project URL and publishable key are public (used in the browser client).
# Legacy anon key remains a compatibility fallback through the end of 2026.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ProjectCEO invitation/guest opaque-token derivation — SERVER ONLY.
# Use at least 32 random bytes; rotating it invalidates unaccepted raw links.
PROJECTCEO_TOKEN_SECRET=replace-with-at-least-32-random-bytes

# ── LLM provider (продукт) ───────────────────────────────
# yandex | gigachat | zai
# ВНИМАНИЕ: 'zai' (Zhipu GLM, китайский провайдер) — отступление от guardrail
# CLAUDE.md, включён по явному решению владельца. Прод по умолчанию — yandex.
LLM_PROVIDER=yandex
# YandexGPT: yandexgpt-lite | yandexgpt   (или полный gpt://<folder>/<model>/latest)
# GigaChat:  GigaChat | GigaChat-Pro
# z.ai:      glm-4.6 | glm-4.5-air | glm-4.7-flash
LLM_MODEL=yandexgpt-lite

# Yandex Cloud Foundation Models
YC_FOLDER_ID=your-folder-id
YC_API_KEY=your-yc-api-key

# GigaChat (запасной провайдер) — заполняется при переключении
GIGACHAT_AUTH_KEY=

# z.ai / Zhipu GLM (опциональный провайдер, LLM_PROVIDER=zai)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI GLM-OCR for plan/image/PDF text extraction.
ZAI_OCR_MODEL=glm-ocr

# ── App ──────────────────────────────────────────────────
# Канонический production URL для публичных ссылок. В локальном .env.local
# используйте http://localhost:3000. Без завершающего слеша.
NEXT_PUBLIC_APP_URL=https://www.remhaos.com

# Контакт поддержки: клиентский бриф (рядом с согласием на ПДн), футер
# лендинга и письма заявок на пилот. Убедитесь, что ящик реально принимает
# почту (иначе выставьте свой, например parkourcafe@gmail.com).
NEXT_PUBLIC_SUPPORT_EMAIL=saidalarust@gmail.com

# Юридические реквизиты владельца/оператора ПДн. Обязательны перед App Store.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Saida Nigmatullaeva
NEXT_PUBLIC_LEGAL_OPERATOR_ADDRESS=Индонезия, Бали, Убуд
NEXT_PUBLIC_LEGAL_OPERATOR_EMAIL=saidalarust@gmail.com
NEXT_PUBLIC_LEGAL_OPERATOR_PHONE=+6281943286395

# Apple Developer Team ID (10 символов). Используется AASA и signing.
APPLE_TEAM_ID=KB7VPWHTTM

# Медиа лендинга. Пусто = CDN Higgsfield (по умолчанию). Чтобы хостить у себя:
#   npm run fetch:media   (скачает файлы в public/landing)
#   NEXT_PUBLIC_MEDIA_BASE=/landing
NEXT_PUBLIC_MEDIA_BASE=

# ── TWA / магазины приложений (Google Play + RuStore) ────
# Digital Asset Links для /.well-known/assetlinks.json (скрывает адресную
# строку в приложении). Заполнить ПОСЛЕ сборки AAB и получения отпечатков.
# Package name приложения, напр. space.arhidom.twa
ANDROID_PACKAGE_NAME=
# Отпечаток(и) SHA-256, через запятую. Нужны ОБА сертификата:
#   1) Google Play App Signing (Play Console → App integrity)
#   2) подпись RuStore (ваш upload keystore)
# Пример: AB:CD:...:EF, 12:34:...:90
ANDROID_CERT_SHA256=

# ── AP1 authenticated pilot (disposable-окружение, НЕ прод) ──
# Используются только скриптом `npm run provision:ap1`, который создаёт пять
# ролевых пользователей (owner/designer/builder/client/guest).
# Домен для тестовых адресов вида owner@ap1.<домен>.
AP1_EMAIL_DOMAIN=remhaos.test
# Пароль для всех пяти тестовых пользователей, минимум 12 символов.
AP1_TEST_PASSWORD=
# Предохранитель: скрипт не запустится без явного AP1_CONFIRM_DISPOSABLE=yes.
# Ставить ТОЛЬКО когда NEXT_PUBLIC_SUPABASE_URL указывает на disposable-проект.
AP1_CONFIRM_DISPOSABLE=

# ── Модуль 2: редактор планировок ────────────────────────────
# Модуль выключен по умолчанию. При false страницы планировок в кабинете и
# /api/layout-studio отдают 404. Данные редактора живут на сервере
# (layout_documents / layout_checkpoints, RLS) — включать можно только после
# применения миграции 20260808050000.
ARCHIDOM_LAYOUT_STUDIO_ENABLED=false
