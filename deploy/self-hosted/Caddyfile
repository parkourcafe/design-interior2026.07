# Шлюз: те же пути, что у облачного Supabase (/auth/v1, /rest/v1, /storage/v1),
# поэтому приложению меняется только адрес. Сертификат HTTPS Caddy получает сам,
# если API_SITE_ADDRESS — доменное имя (например api.remhaos.com).
{
	admin off
}

{$API_SITE_ADDRESS} {
	encode gzip

	@cors_preflight method OPTIONS
	@allowed_origin header_regexp origin Origin ^({$CORS_ALLOWED_ORIGINS})$

	header @allowed_origin {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Credentials true
		Access-Control-Expose-Headers "content-range, x-supabase-api-version"
		Vary Origin
		defer
	}
	handle @cors_preflight {
		header @allowed_origin {
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
			Access-Control-Allow-Headers {http.request.header.Access-Control-Request-Headers}
			Access-Control-Max-Age 3600
		}
		respond 204
	}

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle_path /storage/v1/* {
		reverse_proxy storage:5000
	}
	# Шаблоны писем для Auth (GOTRUE_MAILER_TEMPLATES_*).
	handle_path /email-templates/* {
		root * /srv/email-templates
		file_server
	}
	handle {
		respond "not found" 404
	}
}
